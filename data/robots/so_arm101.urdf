<?xml version="1.0"?>
<!--
  so_arm101 — SYNTHETIC fixture. 6-DOF educational arm with link lengths
  loosely matching The Robot Studio's SO-ARM100/101 specification. Lightweight
  servo-style joints; the gripper at the end is modelled as a fixed link (the
  finger DOF is not part of the manipulator chain we exercise). NOT the
  upstream URDF — see data/robots/README.md.
-->
<robot name="so_arm101">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="shoulder">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0005" iyy="0.0005" izz="0.0005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="upper_arm">
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.0005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="forearm">
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0008" iyy="0.0008" izz="0.0004" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="wrist_pitch">
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0003" iyy="0.0003" izz="0.0003" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="wrist_roll">
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="gripper_palm">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/><child link="shoulder"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="2.0"/>
</joint>
  <joint name="shoulder_lift" type="revolute">
    <parent link="shoulder"/><child link="upper_arm"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="2.0"/>
</joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0 0 0.116" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="2.0"/>
</joint>
  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="forearm"/><child link="wrist_pitch"/>
    <origin xyz="0 0 0.116" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="2.0"/>
</joint>
  <joint name="wrist_roll_joint" type="revolute">
    <parent link="wrist_pitch"/><child link="wrist_roll"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="2.0"/>
</joint>
  <joint name="gripper_fixed" type="fixed">
    <parent link="wrist_roll"/><child link="gripper_palm"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
</robot>
