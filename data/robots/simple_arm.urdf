<?xml version="1.0"?>
<!--
  simple_arm — a 2-DOF planar test fixture for the URDF loader.
  Two revolute joints about z, each link is 1 m long with a 1 kg point mass at
  the link's tip. Used by tests/unit/urdf/test_urdf_loader.cpp.
-->
<robot name="simple_arm">
  <link name="base_link"/>

  <link name="link1">
    <inertial>
      <origin xyz="1.0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0" iyy="0.0" izz="0.0"
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <link name="link2">
    <inertial>
      <origin xyz="1.0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0" iyy="0.0" izz="0.0"
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="1.0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
</robot>
