{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (ASan + UBSan)",
      "description": "Development build with address and UB sanitizers.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TINYSPATIAL_BUILD_TESTS": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimised build; enables benchmarks.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TINYSPATIAL_BUILD_TESTS": "ON",
        "TINYSPATIAL_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "validation",
      "displayName": "Validation (Pinocchio oracle)",
      "description": "Builds the Pinocchio 3.9 parity suite. Requires a conda env; see docker/.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TINYSPATIAL_BUILD_VALIDATION": "ON"
      }
    },
    {
      "name": "wasm",
      "displayName": "WebAssembly (Emscripten)",
      "description": "Builds tinyspatial.js + tinyspatial.wasm via embind. Requires EMSDK in the environment (source emsdk_env.sh first).",
      "inherits": "base",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TINYSPATIAL_BUILD_WASM": "ON",
        "TINYSPATIAL_BUILD_TESTS": "OFF",
        "TINYSPATIAL_BUILD_EXAMPLES": "OFF",
        "CMAKE_CXX_FLAGS": "-fexceptions"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "validation", "configurePreset": "validation" },
    { "name": "wasm", "configurePreset": "wasm" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "validation",
      "configurePreset": "validation",
      "output": { "outputOnFailure": true }
    }
  ]
}
