# tinyspatial C++ style. Based on Google with a wider column limit to suit
# math-heavy expressions. clang-format is ENFORCED in CI (see CLAUDE.md §7).
---
Language: Cpp
BasedOnStyle: Google
Standard: c++20
ColumnLimit: 100
IndentWidth: 2
AccessModifierOffset: -1
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Regroup
SortIncludes: CaseSensitive
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
SpaceBeforeCpp11BracedList: false
IncludeCategories:
  # Corresponding header for a .cpp is priority 0 (handled by IncludeIsMainRegex).
  - Regex: '^<gtest/.*>'
    Priority: 4
  - Regex: '^<Eigen/.*>'
    Priority: 3
  - Regex: '^"tinyspatial/.*"'
    Priority: 2
  - Regex: '^<.*\.h>'
    Priority: 1
  - Regex: '^<.*>'
    Priority: 1
  - Regex: '.*'
    Priority: 2
